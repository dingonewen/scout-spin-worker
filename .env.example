# LLM (any OpenAI-compatible chat-completions endpoint).
# Leave LLM_API_KEY empty to exercise only the deterministic prefilter + stub.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Ticket API. Default points at the local mock (`npm run mock`); set it to the
# real Fastify API for the A/B run.
TICKET_API_URL=http://localhost:8787
TICKET_API_KEY=dev-key
