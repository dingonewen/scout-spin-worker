# scout-spin-worker env vars — REFERENCE ONLY.
#
# There is no dotenv: the code does NOT read this file (or a `.env`). Under
# plain Node (mock/eval), src/config.ts reads `process.env` directly; under
# Spin the same values come from spin.toml [variables] / Fermyon Cloud, not
# from any file on disk.
#
# Set them one of two ways:
#   inline:   LLM_API_KEY=sk-... npm run eval -- ../maildrop/generator/output
#   sourced:  set -a; . ./.env.example; set +a    (exports every KEY=value below)

# LLM (any OpenAI-compatible chat-completions endpoint).
# Leave LLM_API_KEY empty to exercise only the deterministic prefilter + stub.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Ticket API. Default points at the local mock (`npm run mock`); set it to the
# real Fastify API for the A/B run.
TICKET_API_URL=http://localhost:8787
TICKET_API_KEY=dev-key
